# ==============================================================================
# Amazon ML Challenge 2026 - .gitignore
# ==============================================================================

# --- Challenge Datasets (Do NOT push large TSV files to GitHub) ---
dataset/
**/dataset/
*.tsv
*.csv
*.parquet
*.feather
*.h5
*.db
*.sqlite
*.sqlite3

# --- Model Checkpoints & Large Binaries ---
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.onnx
*.bin
*.model

# --- Archives ---
*.zip
*.tar.gz
*.tar
*.gz
*.rar
*.7z

# --- Python Cache & Environments ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.venv/
venv/
ENV/
env/

# --- Jupyter Notebook Checkpoints ---
.ipynb_checkpoints/

# --- IDE & Editor Artifacts ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS-specific Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
__MACOSX/

# --- Logs & Scratch Dumps ---
*.log
scratch/
.system_generated/
